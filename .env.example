# ── TMS — пример конфигурации ─────────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните значения

# ── Безопасность ──────────────────────────────────────────────────────────────
# Секретный ключ для подписи сессионных cookie (обязательно!)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-случайную-строку-минимум-32-символа

# Ключ шифрования секретов в БД (токены, пароли интеграций) — обязательно!
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT_KEY=замените-на-ключ-fernet

# ── Внешние API ───────────────────────────────────────────────────────────────
# Токен DaData для автозаполнения реквизитов контрагентов
# Получить: https://dadata.ru/api/
DADATA_TOKEN=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Токен бота (получить у @BotFather в Telegram)
TMS_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-example

# Список chat_id через запятую (узнать: написать боту /start, затем /status)
# Чтобы узнать свой chat_id, напишите боту @userinfobot
TMS_CHAT_IDS=123456789

# Время отправки отчётов (формат HH:MM, 24-часовой)
TMS_DAILY_TIME=20:00
TMS_WEEKLY_TIME=18:00
TMS_MONTHLY_TIME=20:00
TMS_CALLBACK_TIME=09:00

# Часовой пояс
TMS_TZ=Europe/Moscow

# ── Интеграция 1С:УНФ (push документов из 1С) ─────────────────────────────────
# Ключ для приёма Счёта/УПД из внешней обработки 1С (эндпоинт POST /api/1c/order-document).
# То же значение пропишите в константу КЛЮЧ_API() обработки ОтправкаВTMS.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто = приём из 1С выключен (эндпоинт отвечает 503).
ONEC_PUSH_KEY=

# ── Интеграция Bitrix24 CRM (приём сделок из автоматизации) ───────────────────
# Ключ для приёма сделок из Bitrix24 (эндпоинт POST /api/bitrix/webhook/deal-approved).
# То же значение укажите в URL робота «Вебхук» на нужной стадии в Bitrix24
# (см. Настройки → Интеграции → Bitrix24 → «Как настроить связку с Bitrix24»).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто = приём сделок из Bitrix24 выключен (эндпоинт отвечает 503).
BITRIX_PUSH_KEY=

# Служебный чат для чтения чужих сообщений по реакции: бот пересылает туда
# сообщение бота-помощника (Bot API не умеет читать сообщение по id, а ответ
# forwardMessage содержит текст) и сразу удаляет копию. Пусто — берётся первый
# чат из TMS_CHAT_IDS.
TMS_SERVICE_CHAT_ID=

# ── Подтверждение доставки от «Помощника логиста» ─────────────────────────────
# Ключ для эндпоинта POST /api/carrier/delivery — им бот-помощник сообщает TMS,
# что заказ доставлен («✅ <адрес> | 🟢 <время>»). Отдельный вход нужен потому,
# что Telegram не отдаёт боту сообщения, написанные другим ботом.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто = приём подтверждений выключен (эндпоинт отвечает 503).
CARRIER_PUSH_KEY=

# ── Интеграция с Метафорой / Glide (опционально) ──────────────────────────────
# Firebase API-ключ окружения Glide (для синхронизации логистики)
GLIDE_FB_KEY=
# ID приложения Glide
GLIDE_APP_ID=
