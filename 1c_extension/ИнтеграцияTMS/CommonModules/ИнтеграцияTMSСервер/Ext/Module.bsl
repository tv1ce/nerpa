// Общий модуль "ИнтеграцияTMSСервер" (Сервер, Внешнее соединение).
// Часть расширения "ИнтеграцияTMS". Выдаёт документы заказа в TMS:
//   • Счёт  — PDF печатной формы (Документ.СчетНаОплату)
//   • УПД   — PDF печатной формы (Документ.РасходнаяНакладная)
//   • УПД   — XML в формате ЭДО (подсистема «Электронные документы»)

#Область ПрограммныйИнтерфейс

// type: "invoice" (СчетНаОплату) | "upd" | "tn" (РасходнаяНакладная)
// РефСтр: Ref_Key документа (GUID строкой). Возвращает ДвоичныеДанные PDF.
//
// Имена макетов печати не задаются вручную — перебираем стандартные для УНФ и
// берём первый, который сформировался.
Функция СформироватьPDF(Тип, РефСтр) Экспорт

    Если Тип = "invoice" Тогда
        Ссылка    = Документы.СчетНаОплату.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
        Кандидаты = "Счет,СчетНаОплату,СчетНаОплатуПокупателю,Счет_на_оплату,СчетЗаказ";
    Иначе
        Ссылка = Документы.РасходнаяНакладная.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
        Если Тип = "tn" Тогда
            Кандидаты = "ТоварнаяНакладнаяТОРГ12,ТоварнаяНакладная,ТОРГ12,РасходнаяНакладная";
        Иначе
            Кандидаты = "УПД,УниверсальныйПередаточныйДокумент,УПД_2,УниверсальныйКорректировочныйДокумент";
        КонецЕсли;
    КонецЕсли;

    Если Ссылка.Пустая() Тогда
        ВызватьИсключение "Документ не найден: " + РефСтр;
    КонецЕсли;

    ТабДок = Неопределено;
    Диагностика = "";
    Для Каждого Имя Из СтрРазделить(Кандидаты, ",", Ложь) Цикл
        Имя = СокрЛП(Имя);
        Если ПустаяСтрока(Имя) Тогда Продолжить; КонецЕсли;
        Попытка
            ТабДок = СформироватьТабличныйДокумент(Ссылка, Имя);
        Исключение
            Диагностика = Диагностика + Имя + " — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "; ";
            ТабДок = Неопределено;
        КонецПопытки;
        Если ТабДок <> Неопределено Тогда Прервать; КонецЕсли;
    КонецЦикла;

    Если ТабДок = Неопределено Тогда
        ВызватьИсключение "Печатная форма не сформирована. Пробовали макеты [" + Кандидаты + "]. " + Диагностика;
    КонецЕсли;

    Поток = Новый ПотокВПамяти;
    ТабДок.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
    Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// РефСтр: Ref_Key Документ.РасходнаяНакладная. Возвращает строку XML (формат ФНС, УПД).
//
// Это программный аналог команды «Ещё → ЭДО → Выгрузить электронный документ в файл».
// Конкретный серверный метод зависит от версии библиотеки ЭДО в вашей УНФ —
// 1С-специалисту достаточно подставить ОДИН вызов (см. ниже).
Функция СформироватьУПД_XML(РефСтр) Экспорт

    Ссылка = Документы.РасходнаяНакладная.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
    Если Ссылка.Пустая() Тогда
        ВызватьИсключение "Расходная накладная не найдена: " + РефСтр;
    КонецЕсли;

    // ┌─ ПОДСТАВИТЬ вызов выгрузки ЭД (раз ЭДО работает — метод известен). Варианты:
    // │  • БЭД/1С-ЭДО:  Результат = ЭлектронныеДокументыСлужебный.СформироватьЭлектронныйДокумент(Ссылка);
    // │                 Возврат ПрочитатьВСтроку(Результат); // строка/ДвоичныеДанные/файл
    // │  • Через файл:  ИмяФайла = <метод выгрузки в файл>(Ссылка);
    // │                 Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
    // │                 XML = Чтение.Прочитать(); Чтение.Закрыть(); УдалитьФайлы(ИмяФайла);
    // │                 Возврат XML;
    // └─ Найти точный метод: глобальный поиск по строке "Выгрузить" в модулях ЭДО,
    //    либо отладка команды «ЭДО → Выгрузить в файл» на расходной накладной.

    ВызватьИсключение "СформироватьУПД_XML: подставьте вызов выгрузки ЭД (см. комментарий в модуле)";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

// Формирует ТабличныйДокумент печатной формы. Если в вашей УНФ другая сигнатура
// подсистемы печати — поправьте здесь ОДНО место (общее для всех форм).
Функция СформироватьТабличныйДокумент(Ссылка, ИмяМакета)

    Объекты = Новый Массив;
    Объекты.Добавить(Ссылка);
    Макеты = Новый Массив;
    Макеты.Добавить(ИмяМакета);
    ТабличныеДокументы = Новый СписокЗначений;

    УправлениеПечатью.ПечататьНаборФорм(Макеты, Объекты, ТабличныеДокументы, , , );

    Для Каждого Элемент Из ТабличныеДокументы Цикл
        Если Элемент.Значение <> Неопределено Тогда
            Возврат Элемент.Значение;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

#КонецОбласти
