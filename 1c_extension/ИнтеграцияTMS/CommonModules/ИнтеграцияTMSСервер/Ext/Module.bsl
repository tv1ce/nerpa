// Общий модуль "ИнтеграцияTMSСервер" (Сервер, Вызов сервера — выкл).
// Часть расширения "ИнтеграцияTMS". Выдаёт документы заказа в TMS:
//   • Счёт  — PDF печатной формы (Документ.СчетНаОплату)
//   • УПД   — PDF печатной формы (Документ.РасходнаяНакладная)
//   • УПД   — XML в формате ЭДО (подсистема «Электронные документы»)
//
// ВНИМАНИЕ 1С-специалисту: места, помеченные «# УТОЧНИТЬ», зависят от редакции УНФ.

#Область ПрограммныйИнтерфейс

// type: "invoice" (СчетНаОплату) | "upd" | "tn" (РасходнаяНакладная)
// РефСтр: Ref_Key документа (GUID строкой). Возвращает ДвоичныеДанные PDF.
Функция СформироватьPDF(Тип, РефСтр) Экспорт

    Если Тип = "invoice" Тогда
        Ссылка    = Документы.СчетНаОплату.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
        ИмяМакета = "Счет";                 // # УТОЧНИТЬ имя макета печати счёта
    Иначе
        Ссылка    = Документы.РасходнаяНакладная.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
        ИмяМакета = ?(Тип = "tn", "ТоварнаяНакладная", "УПД");  // # УТОЧНИТЬ имена макетов
    КонецЕсли;

    Если Ссылка.Пустая() Тогда
        ВызватьИсключение "Документ не найден: " + РефСтр;
    КонецЕсли;

    ТабДок = СформироватьТабличныйДокумент(Ссылка, ИмяМакета);

    Поток = Новый ПотокВПамяти;
    ТабДок.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
    Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// РефСтр: Ref_Key Документ.РасходнаяНакладная. Возвращает строку XML (формат ФНС, УПД).
Функция СформироватьУПД_XML(РефСтр) Экспорт

    Ссылка = Документы.РасходнаяНакладная.ПолучитьСсылку(Новый УникальныйИдентификатор(РефСтр));
    Если Ссылка.Пустая() Тогда
        ВызватьИсключение "Расходная накладная не найдена: " + РефСтр;
    КонецЕсли;

    // # УТОЧНИТЬ: вызов того же механизма, что команда «ЭДО → Выгрузить в файл».
    // Имя метода зависит от версии БСП/ЭДО. Метод должен вернуть строку XML,
    // ДвоичныеДанные или путь к временному файлу. Ниже — типовой каркас.
    //
    // Пример (БСП «Обмен электронными документами»):
    //   Результат = ЭлектронныеДокументыСлужебный.СформироватьЭлектронныйДокумент(Ссылка);
    //   Возврат Результат.ДанныеФайла;   // строка XML
    //
    // Если метод отдаёт во временный файл:
    //   ИмяФайла = ...;
    //   Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
    //   XML = Чтение.Прочитать(); Чтение.Закрыть();
    //   УдалитьФайлы(ИмяФайла);
    //   Возврат XML;

    ВызватьИсключение "СформироватьУПД_XML: подставьте вызов выгрузки ЭД (см. комментарий в модуле)";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция СформироватьТабличныйДокумент(Ссылка, ИмяМакета)

    Объекты = Новый Массив;
    Объекты.Добавить(Ссылка);
    Макеты = Новый Массив;
    Макеты.Добавить(ИмяМакета);
    ТабличныеДокументы = Новый СписокЗначений;

    // Стандартный вызов подсистемы печати БСП. Если в вашей УНФ другая сигнатура —
    // используйте УправлениеПечатью.СформироватьПечатныеФормы(...) либо процедуру
    // «Печать» из модуля менеджера документа. Итог — получить ТабличныйДокумент.
    УправлениеПечатью.ПечататьНаборФорм(Макеты, Объекты, ТабличныеДокументы, , , );

    Для Каждого Элемент Из ТабличныеДокументы Цикл
        Возврат Элемент.Значение;
    КонецЦикла;

    ВызватьИсключение "Печатная форма не сформирована: " + ИмяМакета;

КонецФункции

#КонецОбласти
