// Внешняя обработка «Отправка документов в TMS» (вариант A — push из 1С).
// Тип: ДополнительнаяОбработка (БСП «Дополнительные отчёты и обработки»).
//
// Команда «Отправить в TMS» назначается на документы РасходнаяНакладная (УПД)
// и СчётНаОплату (Счёт). По нажатию: формирует PDF печатной формы и POST-ит её
// в TMS, который прикрепляет файл к заказу.
//
// ┌─ ПЕРЕД СБОРКОЙ .epf заполните 4 константы ниже (ХОСТ/ПОРТ/HTTPS/КЛЮЧ). ─┐
// └────────────────────────────────────────────────────────────────────────┘

#Область КонстантыНастройки

// Хост TMS без схемы и пути, напр. "tms.life-it.pro" или IP "203.0.113.10".
Функция ХОСТ_TMS() Экспорт
	Возврат "ВАШ-ХОСТ-TMS";
КонецФункции

// Порт TMS: 443 для HTTPS, 80 или свой (напр. 8000) для HTTP.
Функция ПОРТ_TMS() Экспорт
	Возврат 443;
КонецФункции

// Истина = HTTPS (рекомендуется), Ложь = HTTP.
Функция HTTPS_TMS() Экспорт
	Возврат Истина;
КонецФункции

// Значение из переменной окружения ONEC_PUSH_KEY на сервере TMS.
Функция КЛЮЧ_API() Экспорт
	Возврат "ВСТАВЬТЕ-КЛЮЧ-ONEC_PUSH_KEY";
КонецФункции

#КонецОбласти

#Область СведенияОВнешнейОбработке

// Регистрация обработки в подсистеме БСП. Благодаря этому при «Добавить из файла»
// команда «Отправить в TMS» появляется в формах указанных документов.
Функция СведенияОВнешнейОбработке() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Вид", "ДополнительнаяОбработка");
	Параметры.Вставить("Версия", "1.0");
	Параметры.Вставить("Наименование", "Отправка документов в TMS");
	Параметры.Вставить("БезопасныйРежим", Ложь); // нужен выход в интернет (HTTP)
	Параметры.Вставить("Информация",
		"Отправляет печатную форму Счёта/УПД в TMS и прикрепляет к заказу.");

	Назначение = Новый Массив;
	Назначение.Добавить("Документ.РасходнаяНакладная");
	Назначение.Добавить("Документ.СчетНаОплату");
	Параметры.Вставить("Назначение", Назначение);

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Использование");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Модификатор");

	Команда = Команды.Добавить();
	Команда.Представление        = "Отправить в TMS";
	Команда.Идентификатор        = "ОтправитьВTMS";
	Команда.Использование        = "ВызовСерверногоМетода";
	Команда.ПоказыватьОповещение = Истина;

	Параметры.Вставить("Команды", Команды);
	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ОбработчикиКоманд

// Точка входа команды. Вызывается БСП с массивом ссылок выбранных документов.
Процедура ОтправитьВTMS(Ссылки, ПараметрыВыполнения) Экспорт

	Успешно = 0;
	Ошибок  = 0;
	Для Каждого Ссылка Из Ссылки Цикл
		Попытка
			ОтправитьОдинДокумент(Ссылка);
			Успешно = Успешно + 1;
		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("TMS: ошибка по «" + Строка(Ссылка) + "»: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Сообщить("TMS: отправлено " + Успешно + ", ошибок " + Ошибок + ".");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Готовит и отправляет один документ. Определяет тип печатной формы, GUID'ы
// для привязки к заказу и POST-ит PDF в TMS.
Процедура ОтправитьОдинДокумент(Ссылка)

	МетаИмя = Ссылка.Метаданные().Имя;

	ОрдерGUID    = "";
	РасходGUID   = "";
	СчетGUID     = "";
	ИмяФайла     = "";

	ИмяМенеджера = "Документ." + МетаИмя;

	Если МетаИмя = "РасходнаяНакладная" Тогда
		ТипФайла   = "upd";
		Кандидаты  = "УПД,УниверсальныйПередаточныйДокумент,УПД_2,УниверсальныйКорректировочныйДокумент";
		РасходGUID = Строка(Ссылка.УникальныйИдентификатор());
		// Привязка к заказу: поле «Заказ», иначе основание-счёт
		Попытка
			Если ЗначениеЗаполнено(Ссылка.Заказ) Тогда
				ОрдерGUID = Строка(Ссылка.Заказ.УникальныйИдентификатор());
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Основание = Ссылка.ДокументОснование;
			Если ЗначениеЗаполнено(Основание)
				И Основание.Метаданные().Имя = "СчетНаОплату" Тогда
				СчетGUID = Строка(Основание.УникальныйИдентификатор());
			КонецЕсли;
		Исключение
		КонецПопытки;
		ИмяФайла = "УПД " + Строка(Ссылка.Номер) + ".pdf";

	ИначеЕсли МетаИмя = "СчетНаОплату" Тогда
		ТипФайла  = "invoice";
		Кандидаты = "Счет,СчетНаОплату,СчетНаОплатуПокупателю,Счет_на_оплату,СчетЗаказ";
		СчетGUID  = Строка(Ссылка.УникальныйИдентификатор());
		Попытка
			Если ЗначениеЗаполнено(Ссылка.Заказ) Тогда
				ОрдерGUID = Строка(Ссылка.Заказ.УникальныйИдентификатор());
			КонецЕсли;
		Исключение
		КонецПопытки;
		ИмяФайла = "Счет " + Строка(Ссылка.Номер) + ".pdf";

	Иначе
		ВызватьИсключение "Неподдерживаемый тип документа: " + МетаИмя;
	КонецЕсли;

	PDFДанные = СформироватьPDF(Ссылка, ИмяМенеджера, Кандидаты);
	ОтправитьВСервисTMS(ТипФайла, ИмяФайла, PDFДанные, ОрдерGUID, РасходGUID, СчетGUID);

КонецПроцедуры

// Формирует PDF печатной формы средствами БСП.
// Модуль «УправлениеПечатью» резолвится в рантайме через Вычислить(): обработка
// собирается на учебной платформе (где конфигурации УНФ и её модулей нет), а
// работает на боевой УНФ (где модуль есть). Прямая ссылка дала бы «Переменная не
// определена» на синтакс-контроле учебной базы.
// Метод СформироватьПечатныеФормы возвращает структуру с КоллекцияПечатныхФорм,
// откуда берём ТабличныйДокумент. Имена макетов перебираем (зависят от редакции).
Функция СформироватьPDF(Ссылка, ИмяМенеджера, Кандидаты)

	МодульПечати = Вычислить("УправлениеПечатью"); // резолв в рантайме на сервере УНФ

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);

	ТабДок = Неопределено;
	Диагностика = "";
	Для Каждого Имя Из СтрРазделить(Кандидаты, ",", Ложь) Цикл
		Имя = СокрЛП(Имя);
		Если ПустаяСтрока(Имя) Тогда Продолжить; КонецЕсли;
		Попытка
			Результат = МодульПечати.СформироватьПечатныеФормы(
				ИмяМенеджера, Имя, МассивОбъектов, Новый Структура);
			Если Результат.КоллекцияПечатныхФорм.Количество() > 0 Тогда
				ТабДок = Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
			КонецЕсли;
		Исключение
			Диагностика = Диагностика + Имя + " — "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "; ";
			ТабДок = Неопределено;
		КонецПопытки;
		Если ТабДок <> Неопределено Тогда Прервать; КонецЕсли;
	КонецЦикла;

	Если ТабДок = Неопределено Тогда
		ВызватьИсключение "Печатная форма не сформирована. Менеджер [" + ИмяМенеджера
			+ "], макеты [" + Кандидаты + "]. " + Диагностика;
	КонецЕсли;

	Поток = Новый ПотокВПамяти;
	ТабДок.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// POST сырых байтов файла в TMS. Метаданные — в query-параметрах, ключ — в заголовке.
Процедура ОтправитьВСервисTMS(ТипФайла, ИмяФайла, Данные, ОрдерGUID, РасходGUID, СчетGUID)

	Ресурс = "/api/1c/order-document?file_type=" + ТипФайла;
	Если ЗначениеЗаполнено(ОрдерGUID) Тогда
		Ресурс = Ресурс + "&order_ref=" + ОрдерGUID;
	КонецЕсли;
	Если ЗначениеЗаполнено(РасходGUID) Тогда
		Ресурс = Ресурс + "&shipment_ref=" + РасходGUID;
	КонецЕсли;
	Если ЗначениеЗаполнено(СчетGUID) Тогда
		Ресурс = Ресурс + "&invoice_ref=" + СчетGUID;
	КонецЕсли;
	Ресурс = Ресурс + "&filename="
		+ КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL);

	Защищенное = Неопределено;
	Если HTTPS_TMS() Тогда
		Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	Соединение = Новый HTTPСоединение(ХОСТ_TMS(), ПОРТ_TMS(), , , , 60, Защищенное);
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("X-API-Key", КЛЮЧ_API());
	Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос); // POST

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "TMS HTTP " + Ответ.КодСостояния + ": "
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
