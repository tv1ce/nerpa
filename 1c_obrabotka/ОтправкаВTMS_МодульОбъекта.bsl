// ОтправкаВTMS - модуль объекта (регистрация в БСП). Логика - в модуле формы.

#Область СведенияОВнешнейОбработке

Функция СведенияОВнешнейОбработке() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Вид", "ДополнительнаяОбработка");
	Параметры.Вставить("Версия", "2.0");
	Параметры.Вставить("Наименование", "Отправка документов в TMS");
	Параметры.Вставить("БезопасныйРежим", Ложь); // нужен выход в интернет (HTTPS)
	Параметры.Вставить("Информация",
		"Список проведённых счетов за период. Выбранный счёт отправляется в TMS.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Использование");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Модификатор");

	Команда = Команды.Добавить();
	Команда.Представление        = "Отправка документов в TMS";
	Команда.Идентификатор        = "Форма";          // имя формы, которую откроет БСП
	Команда.Использование        = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	Параметры.Вставить("Команды", Команды);
	Возврат Параметры;

КонецФункции

#КонецОбласти
