// МОДУЛЬ ФОРМЫ «Форма» внешней обработки «Отправка документов в TMS».
//
// Форма показывает проведённые Счета на оплату за период (по умолчанию — текущий
// месяц, период можно менять). Пользователь выбирает счёт в списке и жмёт
// «Отправить в TMS» — только тогда формируется PDF и отправляется на сервер.
//
// Реквизиты формы (создать в конструкторе формы):
//   ПериодС        Дата (состав «Дата»)
//   ПериодПо       Дата (состав «Дата»)
//   ТаблицаСчетов  ТаблицаЗначений с колонками:
//        ВидДок      Строка(20)   — «Счёт» или «Расходная»
//        СчетGUID    Строка(36)   — GUID документа строки (счёт ИЛИ расходная)
//        Номер       Строка(20)
//        Дата        Дата
//        Контрагент  Строка(150)
//        Сумма       Число(15,2)
// Команды формы: Обновить, ОтправитьВTMS.
//
// Обработка НЕ зависит от конфигурации: документ СчетНаОплату не используется как
// тип (его нет на учебной базе сборки). Счёт хранится строкой-GUID, а сам документ
// восстанавливается в рантайме через Вычислить() уже на боевой УНФ.

#Область НастройкиTMS

&НаСервереБезКонтекста
Функция НастройкиTMS()
	Н = Новый Структура;
	Н.Вставить("Хост",  "nuttshell.ru");
	Н.Вставить("Порт",  443);
	Н.Вставить("HTTPS", Истина);
	Н.Вставить("Ключ",  "19tw6HEbZDaUACygidwkY0PHFHtJ3luMmZWeduyxkVM");
	Возврат Н;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(ПериодС) Тогда
		ПериодС = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПериодПо) Тогда
		ПериодПо = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	ЗаполнитьТаблицуСчетов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуСчетов();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВTMS(Команда)
	ТекДанные = Элементы.ТаблицаСчетов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ПоказатьПредупреждение(, "Сначала выберите строку в списке.");
		Возврат;
	КонецЕсли;
	Если ТекДанные.ВидДок = "Расходная" Тогда
		Результат = ОтправитьРасходнуюНаСервере(ТекДанные.СчетGUID);
	Иначе
		Результат = ОтправитьСчетНаСервере(ТекДанные.СчетGUID);
	КонецЕсли;
	ПоказатьПредупреждение(, Результат);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСчетов()
	ТаблицаСчетов.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	""Счёт"" КАК ВидДок,
		|	Счет.Ссылка КАК Ссылка,
		|	Счет.Номер КАК Номер,
		|	Счет.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(Счет.Контрагент) КАК Контрагент,
		|	Счет.СуммаДокумента КАК Сумма
		|ИЗ
		|	Документ.СчетНаОплату КАК Счет
		|ГДЕ
		|	Счет.Проведен = ИСТИНА
		|	И Счет.Дата МЕЖДУ &ПериодС И &ПериодПо
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Расходная"",
		|	Расх.Ссылка,
		|	Расх.Номер,
		|	Расх.Дата,
		|	ПРЕДСТАВЛЕНИЕ(Расх.Контрагент),
		|	Расх.СуммаДокумента
		|ИЗ
		|	Документ.РасходнаяНакладная КАК Расх
		|ГДЕ
		|	Расх.Проведен = ИСТИНА
		|	И Расх.Дата МЕЖДУ &ПериодС И &ПериодПо
		|	И ВЫРАЗИТЬ(Расх.ДокументОснование КАК Документ.СчетНаОплату) ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	Запрос.УстановитьПараметр("ПериодС", НачалоДня(ПериодС));
	Запрос.УстановитьПараметр("ПериодПо", КонецДня(ПериодПо));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = ТаблицаСчетов.Добавить();
		Стр.ВидДок     = Выборка.ВидДок;
		Стр.СчетGUID   = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		Стр.Номер      = Выборка.Номер;
		Стр.Дата       = Выборка.Дата;
		Стр.Контрагент = Выборка.Контрагент;
		Стр.Сумма      = Выборка.Сумма;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьСчетНаСервере(СчетGUID)
	Попытка
		// Восстанавливаем ссылку на счёт по GUID (менеджер документа — через Вычислить,
		// т.к. на учебной базе сборки документа СчетНаОплату нет).
		МенеджерСчета = Вычислить("Документы.СчетНаОплату");
		СчетСсылка = МенеджерСчета.ПолучитьСсылку(Новый УникальныйИдентификатор(СчетGUID));

		Сообщения = Новый Массив;

		// 1. Счёт (PDF печатной формы)
		РезСчет = СформироватьPDF(СчетСсылка, "Документ.СчетНаОплату",
			"Счет", "Счет,СчетНаОплату,СчетНаОплатуПокупателю");
		ОтправитьВСервисTMS("invoice", "Счет " + Строка(СчетСсылка.Номер) + ".pdf",
			РезСчет.Данные, "", "", СчетGUID);
		Сообщения.Добавить("счёт " + Строка(СчетСсылка.Номер));

		// 2. Связанные УПД (расходные накладные на основании счёта) — НЕ фатально:
		// если УПД не сформировалась, счёт всё равно уже отправлен.
		Попытка
			Сообщения.Добавить(ОтправитьУПДпоСчету(СчетСсылка, СчетGUID));
		Исключение
			Сообщения.Добавить("УПД ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Возврат "Отправлено: " + СтрСоединить(Сообщения, ", ");
	Исключение
		Возврат "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Отправка расходной накладной БЕЗ счёта: формируем УПД и шлём как upd.
// Привязка к заказу — по полю «Заказ» расходной (order_ref) и по самой расходной
// (shipment_ref). invoice_ref пустой, т.к. счёта нет.
&НаСервереБезКонтекста
Функция ОтправитьРасходнуюНаСервере(РасхGUID)
	Попытка
		МенеджерРасх = Вычислить("Документы.РасходнаяНакладная");
		РасхСсылка = МенеджерРасх.ПолучитьСсылку(Новый УникальныйИдентификатор(РасхGUID));

		РезУпд = СформироватьPDF(РасхСсылка, "Документ.РасходнаяНакладная",
			"Передаточн", "Обработка.ПечатьСчетФактура.УниверсальныйПередаточныйДокумент,УниверсальныйПередаточныйДокумент");

		ОрдерGUID = "";
		Попытка
			Если ЗначениеЗаполнено(РасхСсылка.Заказ) Тогда
				ОрдерGUID = Строка(РасхСсылка.Заказ.УникальныйИдентификатор());
			КонецЕсли;
		Исключение
		КонецПопытки;

		ОтправитьВСервисTMS("upd", "УПД " + Строка(РасхСсылка.Номер) + ".pdf",
			РезУпд.Данные, ОрдерGUID, РасхGUID, "");
		Возврат "Отправлено: УПД " + Строка(РасхСсылка.Номер)
			+ " (форма [" + РезУпд.Идентификатор + "])";
	Исключение
		Возврат "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Находит проведённые расходные накладные, созданные на основании счёта, и шлёт их
// в TMS как УПД (file_type=upd). Возвращает количество отправленных УПД.
&НаСервереБезКонтекста
Функция ОтправитьУПДпоСчету(СчетСсылка, СчетGUID)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Расх.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасходнаяНакладная КАК Расх
		|ГДЕ
		|	Расх.ДокументОснование = &Счет
		|	И Расх.Проведен = ИСТИНА";
	Запрос.УстановитьПараметр("Счет", СчетСсылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Колво = 0;
	ИнфоФормы = "";
	Пока Выборка.Следующий() Цикл
		РасхСсылка = Выборка.Ссылка;
		РезУпд = СформироватьPDF(РасхСсылка, "Документ.РасходнаяНакладная",
			"Передаточн", "Обработка.ПечатьСчетФактура.УниверсальныйПередаточныйДокумент,УниверсальныйПередаточныйДокумент");
		ИнфоФормы = "выбрана форма [" + РезУпд.Идентификатор + "]; доступны: " + РезУпд.Список;
		РасхGUID = Строка(РасхСсылка.УникальныйИдентификатор());

		// Привязка к заказу: поле «Заказ» расходной (если заполнено)
		ОрдерGUID = "";
		Попытка
			Если ЗначениеЗаполнено(РасхСсылка.Заказ) Тогда
				ОрдерGUID = Строка(РасхСсылка.Заказ.УникальныйИдентификатор());
			КонецЕсли;
		Исключение
		КонецПопытки;

		ОтправитьВСервисTMS("upd", "УПД " + Строка(РасхСсылка.Номер) + ".pdf",
			РезУпд.Данные, ОрдерGUID, РасхGUID, СчетGUID);
		Колво = Колво + 1;
	КонецЦикла;

	Если Колво = 0 Тогда
		Возврат "УПД не найдено (нет проведённой расходной по основанию-счёту)";
	КонецЕсли;
	Возврат "УПД: " + Колво + " шт; " + ИнфоФормы;
КонецФункции

// PDF печатной формы через БСП. Имя макета не угадываем: перечисляем доступные
// печатные формы документа (СоздатьКоллекциюКомандПечати + ДобавитьКомандыПечати) и
// берём ту, чей идентификатор/представление содержит ключевое слово (напр. «УПД»).
// Если автоподбор не сработал — пробуем явные Кандидаты, а при полной неудаче
// сообщаем СПИСОК всех доступных форм. Модуль печати — через Вычислить (учебная база).
&НаСервереБезКонтекста
Функция СформироватьPDF(Ссылка, ИмяМенеджера, КлючевыеСлова, Кандидаты)

	МодульПечати = Вычислить("УправлениеПечатью");

	// 1. Список доступных печатных форм документа
	ДоступныеИдентификаторы = Новый Массив;
	СписокДиагностики = "";
	Попытка
		Коллекция = МодульПечати.СоздатьКоллекциюКомандПечати();
		ИмяДок = Сред(ИмяМенеджера, СтрНайти(ИмяМенеджера, ".") + 1);
		МенеджерДок = Вычислить("Документы." + ИмяДок);
		МенеджерДок.ДобавитьКомандыПечати(Коллекция);
		Для Каждого Ком Из Коллекция Цикл
			// Пропускаем «комплекты» (идентификатор = склейка форм через запятую):
			// из комплекта печатается первая форма, а это обычно не та, что нужна.
			Если ЗначениеЗаполнено(Ком.Идентификатор) И СтрНайти(Ком.Идентификатор, ",") = 0 Тогда
				ДоступныеИдентификаторы.Добавить(Ком.Идентификатор);
				СписокДиагностики = СписокДиагностики
					+ Ком.Идентификатор + " (" + Ком.Представление + "); ";
			КонецЕсли;
		КонецЦикла;
	Исключение
		// перечисление не удалось — пойдём только по явным кандидатам
	КонецПопытки;

	// 2. Очередь проб: сначала совпавшие по ключевым словам, затем явные кандидаты
	Очередь = Новый Массив;
	Для Каждого Слово Из СтрРазделить(КлючевыеСлова, ",", Ложь) Цикл
		Слово = ВРег(СокрЛП(Слово));
		Если ПустаяСтрока(Слово) Тогда Продолжить; КонецЕсли;
		Для Каждого Идент Из ДоступныеИдентификаторы Цикл
			Если СтрНайти(ВРег(Идент), Слово) > 0 Тогда
				Очередь.Добавить(Идент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Канд Из СтрРазделить(Кандидаты, ",", Ложь) Цикл
		Канд = СокрЛП(Канд);
		Если НЕ ПустаяСтрока(Канд) Тогда Очередь.Добавить(Канд); КонецЕсли;
	КонецЦикла;

	// 3. Пробуем сформировать первым подходящим макетом
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);
	ТабДок = Неопределено;
	ИспользованноеИмя = "";
	Для Каждого Имя Из Очередь Цикл
		Попытка
			Результат = МодульПечати.СформироватьПечатныеФормы(
				ИмяМенеджера, Имя, МассивОбъектов, Новый Структура);
			Если Результат.КоллекцияПечатныхФорм.Количество() > 0 Тогда
				ТабДок = Результат.КоллекцияПечатныхФорм[0].ТабличныйДокумент;
				ИспользованноеИмя = Имя;
			КонецЕсли;
		Исключение
			ТабДок = Неопределено;
		КонецПопытки;
		Если ТабДок <> Неопределено Тогда Прервать; КонецЕсли;
	КонецЦикла;

	Если ТабДок = Неопределено Тогда
		ВызватьИсключение "Не удалось сформировать печатную форму [" + ИмяМенеджера
			+ "]. Доступные формы: "
			+ ?(ПустаяСтрока(СписокДиагностики), "(перечислить не удалось)", СписокДиагностики);
	КонецЕсли;

	Поток = Новый ПотокВПамяти;
	ТабДок.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
	Возврат Новый Структура("Данные,Идентификатор,Список",
		Поток.ЗакрытьИПолучитьДвоичныеДанные(), ИспользованноеИмя, СписокДиагностики);

КонецФункции

// POST сырых байтов файла в TMS. Метаданные — в query, ключ — в заголовке.
&НаСервереБезКонтекста
Процедура ОтправитьВСервисTMS(ТипФайла, ИмяФайла, Данные, ОрдерGUID, РасходGUID, СчетGUID)

	Н = НастройкиTMS();

	Ресурс = "/api/1c/order-document?file_type=" + ТипФайла;
	Если ЗначениеЗаполнено(ОрдерGUID) Тогда
		Ресурс = Ресурс + "&order_ref=" + ОрдерGUID;
	КонецЕсли;
	Если ЗначениеЗаполнено(РасходGUID) Тогда
		Ресурс = Ресурс + "&shipment_ref=" + РасходGUID;
	КонецЕсли;
	Если ЗначениеЗаполнено(СчетGUID) Тогда
		Ресурс = Ресурс + "&invoice_ref=" + СчетGUID;
	КонецЕсли;
	Ресурс = Ресурс + "&filename="
		+ КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL);

	Защищенное = Неопределено;
	Если Н.HTTPS Тогда
		Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;

	Соединение = Новый HTTPСоединение(Н.Хост, Н.Порт, , , , 60, Защищенное);
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("X-API-Key", Н.Ключ);
	Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос); // POST

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "TMS HTTP " + Ответ.КодСостояния + ": "
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
